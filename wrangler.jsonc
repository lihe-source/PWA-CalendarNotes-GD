{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendar-notes-pwa-api",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://lihe-source.github.io,http://localhost:8000,http://127.0.0.1:8000",
    "VAPID_SUBJECT": "mailto:rexchre@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calendar-notes-pwa-db",
      "database_id": "8d4c303b-0926-4ebc-b24e-d15da64c9a8f"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
